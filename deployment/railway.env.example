# ============================================================
# ORBITIQ-X — Railway Backend Environment Variables
# ============================================================
# Copy these into Railway → Service → Variables
# Railway auto-provides: DATABASE_URL, REDIS_URL, PORT
# You only need to set the ones below manually.
#
# REQUIRED (must set these in Railway before deploy):
# ============================================================

ORBITIQ_ENV=production
ORBITIQ_VERSION=0.1.0
ORBITIQ_LOG_LEVEL=INFO
ORBITIQ_SECRET_KEY=             # openssl rand -hex 32

BACKEND_RELOAD=false
BACKEND_WORKERS=2
BACKEND_CORS_ORIGINS=https://orbitiq-x.vercel.app,http://localhost:3000

# Railway PostgreSQL plugin provides DATABASE_URL automatically
# Railway Redis plugin provides REDIS_URL automatically
# (You don't need POSTGRES_* or REDIS_* vars when using Railway plugins)

# Still required as Pydantic fields — set dummy values if not using:
POSTGRES_PASSWORD=use-railway-plugin
REDIS_PASSWORD=use-railway-plugin

# JWT
BACKEND_JWT_ALGORITHM=HS256
BACKEND_JWT_EXPIRE_MINUTES=60
BACKEND_JWT_REFRESH_EXPIRE_DAYS=7

# AI (required for agents/GraphRAG)
ANTHROPIC_API_KEY=              # sk-ant-...
OPENAI_API_KEY=                 # sk-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Space-Track (required for catalog sync)
SPACETRACK_IDENTITY=            # your@email.com
SPACETRACK_PASSWORD=            # your password

# Neo4j Aura (free tier — sign up at neo4j.com/cloud/aura-free)
NEO4J_HOST=                     # xxxx.databases.neo4j.io
NEO4J_BOLT_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=                 # from Aura console

# Orbital engine settings
ORBITAL_PROPAGATION_STEP_SECONDS=60
ORBITAL_CONJUNCTION_SCREENING_RANGE_KM=5.0
ORBITAL_CONJUNCTION_PC_THRESHOLD=0.0001
ORBITAL_BATCH_PROPAGATION_WORKERS=4

# Trusted hosts (Railway domain)
TRUSTED_HOSTS=orbitiq-backend.up.railway.app,localhost
