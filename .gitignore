# =============================================================================
# ORBITIQ-X .gitignore — Monorepo
# =============================================================================

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
ENV/
.Python
pip-log.txt
pip-delete-this-directory.txt
.tox/
.nox/
.coverage
.coverage.*
.cache
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
*.prof
*.pstats

# ─── Node / Next.js ───────────────────────────────────────────────────────────
node_modules/
.next/
out/
.nuxt/
.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.yarn/
.pnp.*

# ─── Environment & Secrets ────────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.local.example
!**/.env.example
*.pem
*.key
*.cert
secrets/
**/secrets/
.secrets/

# ─── Databases & Volumes ──────────────────────────────────────────────────────
*.db
*.sqlite3
*.sqlite
pgdata/
neo4j_data/
redis_data/
influx_data/
minio_data/
weaviate_data/

# ─── Data & Embeddings (large files → use DVC or Git LFS) ────────────────────
rag/data/embeddings/*.faiss
rag/data/embeddings/*.index
rag/data/raw/*.pdf
rag/data/processed/*.parquet
datasets/tle/*.txt
datasets/catalogs/*.csv
!datasets/catalogs/sample_*.csv
!datasets/tle/sample.tle

# ─── ML Artifacts ─────────────────────────────────────────────────────────────
*.ckpt
*.safetensors
*.bin
*.onnx
models/
checkpoints/
runs/
mlruns/
wandb/

# ─── Docker / Container ───────────────────────────────────────────────────────
*.dockerignore
docker-compose.override.yml

# ─── IDE & OS ─────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini

# ─── Terraform ────────────────────────────────────────────────────────────────
deployment/terraform/.terraform/
deployment/terraform/*.tfstate
deployment/terraform/*.tfstate.*
deployment/terraform/.terraform.lock.hcl
deployment/terraform/terraform.tfvars
!deployment/terraform/terraform.tfvars.example

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
*.log.*

# ─── Build artifacts ──────────────────────────────────────────────────────────
frontend/.next/
frontend/out/
orbital-engine/dist/
orbital-engine/*.egg-info/
docs/_build/

# ─── Jupyter ──────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ─── Temporary ────────────────────────────────────────────────────────────────
tmp/
temp/
.tmp/
scratch/
