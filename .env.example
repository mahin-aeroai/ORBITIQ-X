# =============================================================================
# ORBITIQ-X Environment Configuration
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# Production secrets MUST be managed via a secret manager (AWS Secrets Manager,
# HashiCorp Vault, or GCP Secret Manager). See docs/architecture/SECRETS.md.
# =============================================================================

# ─── Application ──────────────────────────────────────────────────────────────
ORBITIQ_ENV=development                 # development | staging | production
ORBITIQ_VERSION=0.1.0
ORBITIQ_LOG_LEVEL=DEBUG                 # DEBUG | INFO | WARNING | ERROR | CRITICAL
ORBITIQ_SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# ─── Backend API ──────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=4                       # Increase for production
BACKEND_RELOAD=true                     # Set false in production
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
BACKEND_API_PREFIX=/api/v1
BACKEND_RATE_LIMIT_REQUESTS=100         # Requests per minute per client
BACKEND_JWT_ALGORITHM=HS256
BACKEND_JWT_EXPIRE_MINUTES=60
BACKEND_JWT_REFRESH_EXPIRE_DAYS=7

# ─── PostgreSQL (Primary RDBMS) ───────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=orbitiq_db
POSTGRES_USER=orbitiq
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ─── Redis (Cache & Message Bus) ──────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=0
REDIS_STREAM_AGENT_BUS=orbitiq:agents:bus
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}
REDIS_CACHE_TTL_SECONDS=3600

# ─── Neo4j (Knowledge Graph) ──────────────────────────────────────────────────
NEO4J_HOST=localhost
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME
NEO4J_DATABASE=orbitiq
NEO4J_URI=bolt://${NEO4J_HOST}:${NEO4J_BOLT_PORT}

# ─── Weaviate (Vector Store) ──────────────────────────────────────────────────
WEAVIATE_HOST=localhost
WEAVIATE_PORT=8080
WEAVIATE_GRPC_PORT=50051
WEAVIATE_API_KEY=CHANGE_ME
WEAVIATE_URL=http://${WEAVIATE_HOST}:${WEAVIATE_PORT}
WEAVIATE_CLASS_AEROSPACE_DOC=AerospaceDocument
WEAVIATE_CLASS_RSO=ResidentSpaceObject
WEAVIATE_CLASS_MISSION=Mission

# ─── InfluxDB (Time-Series for Space Weather & TLE History) ───────────────────
INFLUXDB_HOST=localhost
INFLUXDB_PORT=8086
INFLUXDB_ORG=orbitiq-x
INFLUXDB_BUCKET=space_weather
INFLUXDB_TOKEN=CHANGE_ME
INFLUXDB_URL=http://${INFLUXDB_HOST}:${INFLUXDB_PORT}

# ─── MinIO (Object Storage for TLE archives, documents) ───────────────────────
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_BUCKET_TLE=orbitiq-tle
MINIO_BUCKET_DOCS=orbitiq-docs
MINIO_BUCKET_MODELS=orbitiq-models
MINIO_URL=http://${MINIO_HOST}:${MINIO_PORT}

# ─── AI / LLM ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=CHANGE_ME
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=4096

OPENAI_API_KEY=CHANGE_ME                # Used for text-embedding-3-large
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=3072

# Local / self-hosted model (optional, for RAG generation)
LOCAL_LLM_URL=http://localhost:11434    # Ollama endpoint
LOCAL_LLM_MODEL=llama3.1:8b

# ─── External Space Data APIs ─────────────────────────────────────────────────
SPACETRACK_IDENTITY=your@email.com      # Space-Track.org credentials
SPACETRACK_PASSWORD=CHANGE_ME
SPACETRACK_BASE_URL=https://www.space-track.org
SPACETRACK_RATE_LIMIT_PER_HOUR=300

CELESTRAK_BASE_URL=https://celestrak.org
CELESTRAK_RATE_LIMIT_PER_HOUR=1000

NASA_API_KEY=CHANGE_ME                  # api.nasa.gov
NASA_NEOWS_URL=https://api.nasa.gov/neo/rest/v1

NOAA_SPACE_WEATHER_URL=https://services.swpc.noaa.gov

# ─── Orbital Engine ───────────────────────────────────────────────────────────
ORBITAL_PROPAGATION_STEP_SECONDS=60
ORBITAL_MAX_PROPAGATION_DAYS=30
ORBITAL_SGP4_WGS=72                    # 72 | 84 (WGS-72 or WGS-84)
ORBITAL_CONJUNCTION_SCREENING_RANGE_KM=5.0
ORBITAL_CONJUNCTION_PC_THRESHOLD=0.0001
ORBITAL_BATCH_PROPAGATION_WORKERS=8

# ─── RAG Pipeline ─────────────────────────────────────────────────────────────
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_TOP_K_RETRIEVAL=10
RAG_TOP_K_RERANK=3
RAG_EMBEDDING_BATCH_SIZE=32
RAG_MIN_RELEVANCE_SCORE=0.65

# ─── Agent System ─────────────────────────────────────────────────────────────
AGENT_MAX_ITERATIONS=15
AGENT_TIMEOUT_SECONDS=120
AGENT_TEMPERATURE=0.1
AGENT_VERBOSE=true

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_APP_NAME=ORBITIQ-X
NEXT_PUBLIC_MAP_STYLE=dark                  # dark | light | satellite
NEXT_PUBLIC_CESIUM_ACCESS_TOKEN=CHANGE_ME   # For 3D globe (Cesium ion)
NEXT_PUBLIC_POSTHOG_KEY=CHANGE_ME           # Analytics (optional)
NEXT_PUBLIC_SENTRY_DSN=CHANGE_ME            # Error tracking (optional)

# ─── Monitoring & Observability ───────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
SENTRY_DSN=CHANGE_ME
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317  # OpenTelemetry Collector
OTEL_SERVICE_NAME=orbitiq-x-backend

# ─── Security ─────────────────────────────────────────────────────────────────
SSL_CERT_PATH=/etc/ssl/certs/orbitiq.crt
SSL_KEY_PATH=/etc/ssl/private/orbitiq.key
TRUSTED_HOSTS=localhost,127.0.0.1
ALLOWED_IPS=                            # Comma-separated allowlist (empty = all)
