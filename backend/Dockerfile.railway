FROM python:3.11-slim-bookworm

WORKDIR /app

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ libpq-dev curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for layer caching
COPY backend/requirements/base.txt requirements/base.txt
RUN pip install --no-cache-dir -r requirements/base.txt

# Copy backend application
COPY backend/ .

# Copy orbital-engine (used by digital twin services)
COPY orbital-engine/ /app/orbital-engine/

# Copy agents directory (used by agent_service.py)
COPY agents/ /app/agents/

# Copy RAG pipeline (used by GraphRAG bridge)
COPY rag/ /app/rag/

# Copy scripts (used by entity seed endpoints, corpus loaders, etc.)
COPY scripts/ /app/scripts/

WORKDIR /app

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8000}/health || exit 1

CMD ["python3", "entrypoint.sh"]
